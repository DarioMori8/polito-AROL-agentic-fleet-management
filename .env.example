# Single environment file for the whole project.
# Copy it to .env (same folder) and replace every <...> value.
#
# Who reads it:
#   - docker compose: only for ${...} substitution in docker-compose.yml and
#     langfuse-local/docker-compose.yml. Containers get just the variables the
#     compose files pass them explicitly.
#   - backend and agents, when run locally (outside Docker).
#   - frontend (Vite dev server): only the VITE_* variables.

# ---------- Langfuse API keys (backend + agents) ----------
# Created in the Langfuse UI (http://localhost:3000): project → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=pk-lf-<...>
LANGFUSE_SECRET_KEY=sk-lf-<...>
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_TRACING_ENABLED=true

# ---------- LLM models (Ollama) ----------
ORCHESTRATOR_OLLAMA_MODEL=gpt-oss:20b
OLLAMA_MODEL=gpt-oss:20b
EMBEDDING_MODEL=nomic-embed-text
# Optional: context window of the orchestrator under Docker (default 16384)
# ORCHESTRATOR_NUM_CTX=16384

# ---------- Local runs only (Docker sets its own values) ----------
# Agents run from agents/, so the manuals folder is one level up.
MANUALS_PATH=../data/manuals

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=false

# ---------- Langfuse self-hosted instance (langfuse-local) ----------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<openssl rand -base64 32>
SALT=<openssl rand -base64 16>
ENCRYPTION_KEY=<openssl rand -hex 32>

POSTGRES_USER=langfuse
POSTGRES_PASSWORD=<postgres password>
POSTGRES_DB=langfuse
DATABASE_URL=postgresql://langfuse:<postgres password>@postgres:5432/langfuse

CLICKHOUSE_PASSWORD=<clickhouse password>

# The S3 keys must match the MinIO user and password.
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=<minio password>
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=<minio password>
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=<minio password>

