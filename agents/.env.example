LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
EMBEDDING_MODEL=nomic-embed-text

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

MAX_ITERATIONS=5
CHROMA_PATH=./data/chroma
# Inside Docker this is the read-only mount of the shared manuals volume
# (/data/manuals). Running locally from agents/, point it at the repo folder.
MANUALS_PATH=../data/manuals
DOCS_SERVICE_URL=http://localhost:8003
IOT_SERVICE_URL=http://localhost:8003
