# Exclude heavy directories that are rebuilt inside the container
node_modules
dist

# Storybook build output
storybook-static

# Dev/test artifacts
coverage
.nyc_output

# Editor & OS noise
.vscode
.idea
*.log
.DS_Store
Thumbs.db

# Git history (not needed in image)
.git
.gitignore

# Local env overrides (secrets should come from compose / CI)
.env.local
.env.*.local
