# Chroma index, mock-backoffice SQLite rebuilt from the workbook
/data/
backend/data/
agents/data/
mock-backoffice/data/
*.pdf

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sw?
.claude/launch.json

# Personal / local
.agents/
AGENTS.md
temp/
