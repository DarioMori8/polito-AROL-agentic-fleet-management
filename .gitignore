# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/

# Env / secrets
.env
.env.*
!.env.example

# Generated / non-distributable data.
# Listed one by one on purpose: a bare `data/` would also swallow the seed files
# in mock-backoffice/data, and git cannot re-include a file once its parent
# directory is excluded, so a `!` rule would not bring them back.
# machine manuals: 73 MB, AROL property
/data/
backend/data
# Chroma index, rebuilt by the ingestion
agents/data/
# SQLite, rebuilt from the workbook at startup
*.db
*.sqlite3

# Node (in case anything outside frontend/ ever needs it)
node_modules/

# OS / editor
.DS_Store
.vscode/
.idea/
.agents/

temp/

